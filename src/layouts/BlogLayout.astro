---
import type { CollectionEntry } from 'astro:content';
import '../styles/global.css';
import SiteHead from '@components/SiteHead.astro';
import ArticleContainer from '@components/ArticleContainer.astro';
import BackButton from '@components/BackButton.astro';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { title, description, date, image, tags = [] } = entry.data;
const { Content } = await entry.render();

const metaDescription =
  description || `Blog post by Daffa Maulana Satria: ${title}`;
const ogImage = image || '/artworks/Mikazuki.webp';

const blogJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: metaDescription,
  datePublished: date.toISOString(),
  image: `https://arucaden.my.id${ogImage.startsWith('/') ? ogImage : `/${ogImage}`}`,
  author: {
    '@type': 'Person',
    name: 'Daffa Maulana Satria',
    url: 'https://arucaden.my.id',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(Astro.url.pathname, 'https://arucaden.my.id').toString(),
  },
  keywords: tags.join(', '),
};
---

<html lang="en">
  <head>
    <SiteHead
      title={`${title} | Daffa Maulana Satria`}
      description={metaDescription}
      ogType="article"
      ogImage={ogImage}
      jsonLd={blogJsonLd}
    />
  </head>

  <body class="crt-bg-flat min-h-screen mx-auto">
    <article class="max-w-4xl mx-auto px-4 sm:px-6 md:px-8 py-8 md:py-12">
      <BackButton href="/#blogs" text="Back to Blog" />

      <ArticleContainer title={title}>
        <div class="text-sm text-white-text sm:text-base mt-6 break-words overflow-hidden">
          <div class="w-full purosu max-w-none">
            <Content />
          </div>
        </div>
      </ArticleContainer>

      <div class="mt-16 flex justify-center">
        <button
          type="button"
          onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
          class="group flex items-center gap-2 text-main hover:text-white transition-colors"
          aria-label="Scroll back to top"
        >
          <span class="text-sm font-bold tracking-wider uppercase">Back to Top</span>
          <img
            src="/icons/arrow-down.svg"
            alt=""
            class="w-5 h-5 rotate-180 transition-transform duration-300 transform group-hover:-translate-y-1"
          />
        </button>
      </div>
    </article>
  </body>
</html>
