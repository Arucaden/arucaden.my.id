---
import type { CollectionEntry } from 'astro:content';
import '../styles/global.css';
import SiteHead from '@components/SiteHead.astro';
import ArticleContainer from '@components/ArticleContainer.astro';
import BackButton from '@components/BackButton.astro';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { title, description, date, image, tags = [] } = entry.data;
const { Content } = await entry.render();

const metaDescription =
  description || `Blog post by Daffa Maulana Satria: ${title}`;
const ogImage = image || '/artworks/Mikazuki.webp';

const blogJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: metaDescription,
  datePublished: date.toISOString(),
  image: `https://arucaden.my.id${ogImage.startsWith('/') ? ogImage : `/${ogImage}`}`,
  author: {
    '@type': 'Person',
    name: 'Daffa Maulana Satria',
    url: 'https://arucaden.my.id',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(Astro.url.pathname, 'https://arucaden.my.id').toString(),
  },
  keywords: tags.join(', '),
};
---

<html lang="en">
  <head>
    <SiteHead
      title={`${title} | Daffa Maulana Satria`}
      description={metaDescription}
      ogType="article"
      ogImage={ogImage}
      jsonLd={blogJsonLd}
    />
  </head>

  <body class="crt-bg min-h-screen text-white custom-scroll antialiased selection:bg-main selection:text-black">
    <main class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-12 xl:px-24 py-8 md:py-16">
      <BackButton href="/#blogs" text="Back to Blog" />

      <ArticleContainer title={title}>
        <div class="text-sm sm:text-base text-gray-text mt-4 w-full overflow-hidden">
          <div class="w-full max-w-none purosu">
            <Content />
          </div>
        </div>
      </ArticleContainer>

      <div class="mt-12 flex justify-center">
        <button
          type="button"
          onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
          class="btn-secondary group text-xs font-mono py-2 px-5"
          aria-label="Scroll back to top"
        >
          <span class="i-ri-arrow-up-line w-4 h-4 text-main transition-transform group-hover:-translate-y-1"></span>
          <span>Back to Top</span>
        </button>
      </div>
    </main>
  </body>
</html>
