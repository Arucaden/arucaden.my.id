---
import type { CollectionEntry } from 'astro:content';
import '../styles/global.css';
import SiteHead from '@components/SiteHead.astro';
import ArticleContainer from '@components/ArticleContainer.astro';
import ProjectSidebar from '@components/Projects/ProjectSidebar.astro';
import BackButton from '@components/BackButton.astro';

interface Props {
  content: CollectionEntry<'projects'>;
}

const { content } = Astro.props;
const { title, image, description, tech = [], url, sourceUrl, date } = content.data;
const { Content, headings } = await content.render();

const metaDescription =
  description || `Project by Daffa Maulana Satria: ${title}`;
const ogImage = image || '/artworks/Mikazuki.webp';

const projectJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  description: metaDescription,
  datePublished: date.toISOString(),
  image: `https://arucaden.my.id${ogImage.startsWith('/') ? ogImage : `/${ogImage}`}`,
  author: {
    '@type': 'Person',
    name: 'Daffa Maulana Satria',
    url: 'https://arucaden.my.id',
  },
  url: new URL(Astro.url.pathname, 'https://arucaden.my.id').toString(),
  ...(url ? { sameAs: [url] } : {}),
};
---

<html lang="en">
  <head>
    <SiteHead
      title={`${title} | Daffa Maulana Satria`}
      description={metaDescription}
      ogType="article"
      ogImage={ogImage}
      jsonLd={projectJsonLd}
    />
  </head>

  <body class="crt-bg min-h-screen text-white custom-scroll antialiased selection:bg-main selection:text-black">
    <main class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-12 py-8 md:py-16">
      <BackButton href="/#projects" text="Back to Projects" />

      <ArticleContainer title={title}>
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-8 items-start">
          <!-- Main Content Column -->
          <div class="space-y-6 overflow-hidden">
            {image && (
              <div class="overflow-hidden rounded-2xl border border-white/10 shadow-xl">
                <img
                  src={image}
                  alt={title}
                  width={1200}
                  height={675}
                  class="w-full object-cover aspect-video"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}

            <div class="text-sm sm:text-base text-gray-text mt-6 break-words overflow-hidden">
              <div class="w-full purosu">
                <Content />
              </div>
            </div>
          </div>

          <!-- Sticky Sidebar -->
          <ProjectSidebar
            title={title}
            tech={tech}
            url={url}
            sourceUrl={sourceUrl}
            headings={headings}
          />
        </div>
      </ArticleContainer>

      <div class="mt-12 flex justify-center">
        <button
          type="button"
          onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
          class="btn-secondary group text-xs font-mono py-2 px-5"
          aria-label="Scroll back to top"
        >
          <span class="i-ri-arrow-up-line w-4 h-4 text-main transition-transform group-hover:-translate-y-1"></span>
          <span>Back to Top</span>
        </button>
      </div>
    </main>
  </body>
</html>
