---
import type { CollectionEntry } from 'astro:content';
import '../styles/global.css';
import SiteHead from '@components/SiteHead.astro';
import ArticleContainer from '@components/ArticleContainer.astro';
import ProjectSidebar from '@components/Projects/ProjectSidebar.astro';
import ProjectGallery from '@components/Projects/ProjectGallery.svelte';
import BackButton from '@components/BackButton.astro';

interface Props {
  content: CollectionEntry<'projects'>;
}

const { content } = Astro.props;
const {
  title,
  image,
  description,
  tech = [],
  url,
  liveUrl,
  sourceUrl,
  repoUrl,
  gallery = [],
  date,
} = content.data;

const finalLiveUrl = liveUrl || url;
const finalSourceUrl = sourceUrl || repoUrl;

// Normalize gallery items to { src: string, alt: string, caption?: string }
const normalizedGallery = gallery.map((item, index) => {
  if (typeof item === 'string') {
    return {
      src: item,
      alt: `${title} snapshot ${index + 1}`,
      caption: undefined,
    };
  }
  return {
    src: item.src,
    alt: item.alt || item.caption || `${title} snapshot ${index + 1}`,
    caption: item.caption,
  };
});

const hasGallery = normalizedGallery.length > 0;

const { Content, headings } = await content.render();

// If hasGallery, add gallery to headings so it shows up in Table of Contents
const enhancedHeadings = hasGallery
  ? [...headings, { depth: 2, slug: 'gallery', text: 'App Snapshots' }]
  : headings;

const metaDescription =
  description || `Project by Daffa Maulana Satria: ${title}`;
const ogImage = image || '/artworks/Mikazuki.webp';

const galleryImageUrls = normalizedGallery.map((img) =>
  `https://arucaden.my.id${img.src.startsWith('/') ? img.src : `/${img.src}`}`
);

const allImages = [
  `https://arucaden.my.id${ogImage.startsWith('/') ? ogImage : `/${ogImage}`}`,
  ...galleryImageUrls,
];

const sameAsLinks = [finalLiveUrl, finalSourceUrl].filter(
  (l): l is string => Boolean(l)
);

const projectJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  description: metaDescription,
  datePublished: date.toISOString(),
  image: allImages.length === 1 ? allImages[0] : allImages,
  author: {
    '@type': 'Person',
    name: 'Daffa Maulana Satria',
    url: 'https://arucaden.my.id',
  },
  url: new URL(Astro.url.pathname, 'https://arucaden.my.id').toString(),
  ...(sameAsLinks.length > 0 ? { sameAs: sameAsLinks } : {}),
  ...(finalSourceUrl ? { codeRepository: finalSourceUrl } : {}),
};
---

<html lang="en">
  <head>
    <SiteHead
      title={`${title} | Daffa Maulana Satria`}
      ogType="article"
      ogImage={ogImage}
      jsonLd={projectJsonLd}
    />
  </head>

  <body class="crt-bg min-h-screen text-white custom-scroll antialiased selection:bg-main selection:text-black">
    <main class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-12 xl:px-24 py-8 md:py-16">
      <BackButton href="/#projects" text="Back to Projects" />

      <ArticleContainer title={title}>
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_300px] gap-8 items-start">
          <!-- Main Content Column -->
          <div class="w-full space-y-6 overflow-hidden">
            {image && (
              <div class="overflow-hidden rounded-2xl border border-white/10 shadow-xl">
                <img
                  src={image}
                  alt={title}
                  width={1200}
                  height={675}
                  class="w-full object-cover aspect-video"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}

            <div class="text-sm sm:text-base text-gray-text mt-6 w-full overflow-hidden">
              <div class="w-full max-w-none purosu">
                <Content />
              </div>
            </div>

            <!-- Project Gallery / App Snapshots -->
            {hasGallery && (
              <section id="gallery" class="pt-8 mt-10 border-t border-white/10 scroll-mt-20">
                <div class="mb-5 flex flex-col gap-1">
                    <h2 class="text-lg sm:text-xl font-mono font-bold tracking-wider text-white uppercase m-0">
                      App Snapshots
                    </h2>
                  <p class="text-xs sm:text-sm font-mono text-gray-text m-0">
                    Visual previews for this application. Click any image to zoom.
                  </p>
                </div>

                <ProjectGallery client:idle items={normalizedGallery} />
              </section>
            )}
          </div>

          <!-- Sticky Sidebar -->
          <ProjectSidebar
            title={title}
            tech={tech}
            url={finalLiveUrl}
            sourceUrl={finalSourceUrl}
            hasGallery={hasGallery}
            headings={enhancedHeadings}
          />
        </div>
      </ArticleContainer>

      <div class="mt-12 flex justify-center">
        <button
          type="button"
          onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
          class="btn-secondary group text-xs font-mono py-2 px-5"
          aria-label="Scroll back to top"
        >
          <span class="i-ri-arrow-up-line w-4 h-4 text-main transition-transform group-hover:-translate-y-1"></span>
          <span>Back to Top</span>
        </button>
      </div>
    </main>
  </body>
</html>
