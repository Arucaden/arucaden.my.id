---
import type { CollectionEntry } from 'astro:content';
import '../styles/global.css';
import SiteHead from '@components/SiteHead.astro';
import ArticleContainer from '@components/ArticleContainer.astro';
import ProjectSidebar from '@components/Projects/ProjectSidebar.astro';
import BackButton from '@components/BackButton.astro';

interface Props {
  content: CollectionEntry<'projects'>;
}

const { content } = Astro.props;
const { title, image, description, tech = [], url, sourceUrl, date } = content.data;
const { Content, headings } = await content.render();

const metaDescription =
  description || `Project by Daffa Maulana Satria: ${title}`;
const ogImage = image || '/artworks/Mikazuki.webp';

const projectJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  description: metaDescription,
  datePublished: date.toISOString(),
  image: `https://arucaden.my.id${ogImage.startsWith('/') ? ogImage : `/${ogImage}`}`,
  author: {
    '@type': 'Person',
    name: 'Daffa Maulana Satria',
    url: 'https://arucaden.my.id',
  },
  url: new URL(Astro.url.pathname, 'https://arucaden.my.id').toString(),
  ...(url ? { sameAs: [url] } : {}),
};
---

<html lang="en">
  <head>
    <SiteHead
      title={`${title} | Daffa Maulana Satria`}
      description={metaDescription}
      ogType="article"
      ogImage={ogImage}
      jsonLd={projectJsonLd}
    />
  </head>

  <body class="crt-bg-flat min-h-screen mx-auto">
    <article class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-12 xl:px-24 py-8 md:py-12">
      <BackButton href="/#projects" text="Back to Projects" />

      <ArticleContainer title={title}>
        <!-- Mobile -->
        <div class="md:hidden space-y-6">
          {image && (
            <img
              src={image}
              alt={title}
              width={800}
              height={450}
              class="image-border2 w-full object-cover aspect-video"
              loading="lazy"
              decoding="async"
            />
          )}

          <ProjectSidebar
            title={title}
            tech={tech}
            url={url}
            sourceUrl={sourceUrl}
          />

          <div class="text-sm text-white-text sm:text-base mt-4 break-words overflow-hidden">
            <div class="w-full purosu">
              <Content />
            </div>
          </div>
        </div>

        <!-- Desktop -->
        <div class="hidden md:grid md:grid-cols-[3fr_auto_1fr] gap-6">
          <div class="w-full overflow-hidden">
            {image && (
              <img
                src={image}
                alt={title}
                width={1200}
                height={675}
                class="image-border2 w-full object-cover aspect-video"
                loading="lazy"
                decoding="async"
              />
            )}

            <div class="text-sm text-white-text sm:text-base mt-4 break-words overflow-hidden">
              <div class="w-full purosu max-w-none">
                <Content />
              </div>
            </div>
          </div>

          <div class="bg-tertiary w-2px h-full"></div>

          <ProjectSidebar
            title={title}
            tech={tech}
            url={url}
            sourceUrl={sourceUrl}
            headings={headings}
          />
        </div>
      </ArticleContainer>
    </article>
  </body>
</html>
