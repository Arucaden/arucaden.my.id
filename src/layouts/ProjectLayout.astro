---
import type { CollectionEntry } from 'astro:content';
import '../styles/global.css';
import SiteHead from '@components/SiteHead.astro';
import ArticleContainer from '@components/ArticleContainer.astro';
import ProjectSidebar from '@components/Projects/ProjectSidebar.astro';
import BackButton from '@components/BackButton.astro';

interface Props {
  content: CollectionEntry<'projects'>;
}

const { content } = Astro.props;
const { title, image, description, tech = [], url, sourceUrl, date } = content.data;
const { Content, headings } = await content.render();

const metaDescription =
  description || `Project by Daffa Maulana Satria: ${title}`;
const ogImage = image || '/artworks/Mikazuki.webp';

const projectJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  description: metaDescription,
  datePublished: date.toISOString(),
  image: `https://arucaden.my.id${ogImage.startsWith('/') ? ogImage : `/${ogImage}`}`,
  author: {
    '@type': 'Person',
    name: 'Daffa Maulana Satria',
    url: 'https://arucaden.my.id',
  },
  url: new URL(Astro.url.pathname, 'https://arucaden.my.id').toString(),
  ...(url ? { sameAs: [url] } : {}),
};
---

<html lang="en">
  <head>
    <SiteHead
      title={`${title} | Daffa Maulana Satria`}
      description={metaDescription}
      ogType="article"
      ogImage={ogImage}
      jsonLd={projectJsonLd}
    />
  </head>

  <body class="crt-bg-flat min-h-screen mx-auto custom-scroll">
    <article class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-12 xl:px-24 py-8 md:py-12">
      <BackButton href="/#projects" text="Back to Projects" />

      <ArticleContainer title={title}>
        <div class="grid grid-cols-1 md:grid-cols-[3fr_auto_1fr] gap-6">
          <div class="w-full overflow-hidden space-y-6">
            {image && (
              <img
                src={image}
                alt={title}
                width={1200}
                height={675}
                class="image-border2 w-full object-cover aspect-video"
                loading="lazy"
                decoding="async"
              />
            )}

            <!-- Mobile metadata and Table of Contents (shown only on mobile) -->
            <div class="block md:hidden">
              <ProjectSidebar
                title={title}
                tech={tech}
                url={url}
                sourceUrl={sourceUrl}
                headings={headings}
              />
            </div>

            <!-- Single Content instance to prevent duplicate heading IDs -->
            <div class="text-sm text-white-text sm:text-base break-words overflow-hidden">
              <div class="w-full purosu max-w-none">
                <Content />
              </div>
            </div>
          </div>

          <!-- Desktop Vertical Divider -->
          <div class="hidden md:block bg-tertiary w-2px h-full"></div>

          <!-- Desktop Sidebar with Table of Contents -->
          <div class="hidden md:block">
            <ProjectSidebar
              title={title}
              tech={tech}
              url={url}
              sourceUrl={sourceUrl}
              headings={headings}
            />
          </div>
        </div>
      </ArticleContainer>
    </article>
  </body>
</html>
