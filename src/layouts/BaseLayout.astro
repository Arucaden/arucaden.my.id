---
import Navbar from '@components/Navbar/Navbar.svelte';
import SiteHead from '@components/SiteHead.astro';
import '../styles/global.css';
import HeroSection from '@components/HeroSection.astro';

const pageTitle = 'Daffa Maulana Satria';
const description =
  'Game Developer, 2D Illustrator, and UI/UX Designer - Gamedev - Illustrator.';

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Daffa Maulana Satria',
  url: 'https://arucaden.my.id',
  jobTitle: ['Game Developer', 'Front End Developer', '2D Illustrator', 'UI/UX Designer'],
  sameAs: [
    'https://github.com/Arucaden',
    'https://linkedin.com/in/daffa-ms',
    'https://itch.io/profile/arucaden',
  ],
};
---

<html lang="en">
  <head>
    <SiteHead
      title={pageTitle}
      description={description}
      ogType="website"
      ogImage="/artworks/Mikazuki.webp"
      jsonLd={personJsonLd}
    />
    <link rel="preload" as="image" href="/artworks/Mikazuki.webp" fetchpriority="high" />
  </head>

  <body class="flex crt-bg flex-col text-white min-h-screen custom-scroll">
    <a
      href="#profile"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-main focus:text-black-text focus:px-4 focus:py-2 focus:rounded-lg"
    >
      Skip to content
    </a>
    <HeroSection />
    <main class="flex-grow mx-auto w-full max-w-7xl px-4 sm:px-6 md:px-8 lg:px-12 xl:px-24 pt-8 md:pt-12">
      <Navbar client:load />
      <slot />
    </main>
    <footer class="w-full h-12 text-center flex items-center justify-center mt-4 md:mt-0 mb-16 md:mb-4">
      <span class="text-center text-sm text-main">
        &copy; 2026 Daffa Maulana Satria. All rights reserved.
      </span>
    </footer>
  </body>
</html>
