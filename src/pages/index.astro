---
import Layout from '../layouts/BaseLayout.astro';
import Profile from '@components/Profile/ProfileWrapper.astro';
import Artworks from '@components/Artwork/ArtworkWrapper.svelte';
import Projects from '@components/Projects/ProjectWrapper.svelte';
import Blogs from '@components/Blog/BlogWrapper.astro';
import InteractiveLab from '@components/Lab/InteractiveLab.svelte';
import { artworks } from '@data/artworks.ts';
import { getCollection } from 'astro:content';
import Container from '@components/Container.astro';

const projectEntries = await getCollection('projects', ({ data }) => {
  return data.draft !== true;
});

let projects = projectEntries.map((entry) => ({
  ...entry.data,
  date: entry.data.date.toISOString(),
  description: entry.data.description ?? '',
  image: entry.data.image ?? '',
  tech: entry.data.tech ?? [],
  slug: entry.slug,
}));

const blogEntries = await getCollection('blog', ({ data }) => {
  return data.draft !== true;
});

let blogs = blogEntries.map((entry) => ({
  title: entry.data.title,
  slug: entry.slug,
  excerpt: entry.data.description ?? '',
  date: entry.data.date.toISOString(),
  readTime: entry.data.readTime,
  tags: entry.data.tags,
  href: `/blog/${entry.slug}`,
  pin: entry.data.pin,
}));

projects = projects.sort((a, b) => {
  if (a.pin && !b.pin) return -1;
  if (!a.pin && b.pin) return 1;
  const dateA = a.date ? new Date(a.date).getTime() : 0;
  const dateB = b.date ? new Date(b.date).getTime() : 0;
  return dateB - dateA;
});

blogs = blogs.sort((a, b) => {
  if (a.pin && !b.pin) return -1;
  if (!a.pin && b.pin) return 1;
  const dateA = a.date ? new Date(a.date).getTime() : 0;
  const dateB = b.date ? new Date(b.date).getTime() : 0;
  return dateB - dateA;
});
---

<Layout>
  <!-- 1. Featured Case Studies & Projects (Top Priority for UI/UX Recruiter) -->
  <section
    id="projects"
    class="scroll-animate h-auto pb-16 md:pb-24 pt-2 flex flex-col md:scroll-mt-24"
    aria-labelledby="projects-heading"
  >
    <Container
      title="Selected Works"
      tag="// 01. CASE STUDIES"
      subtitle="Comprehensive UI/UX workflows, interactive web applications, and game systems."
      headingId="projects-heading"
    >
      <Projects projects={projects} client:visible />
    </Container>
  </section>

  <!-- 2. Interactive UI/UX & 3D Lab Playground -->
  <section
    id="lab"
    class="scroll-animate h-auto pb-16 md:pb-24 pt-2 flex flex-col md:scroll-mt-24"
    aria-labelledby="lab-heading"
  >
    <Container
      title="UI/UX & 3D Lab"
      tag="// 02. INTERACTION PLAYGROUND"
      subtitle="Live experimental shaders, tactile spring physics, and design token architecture."
      headingId="lab-heading"
    >
      <InteractiveLab client:visible />
    </Container>
  </section>

  <!-- 3. Profile & Career Trajectory -->
  <section
    id="profile"
    class="scroll-animate h-auto pb-16 md:pb-24 pt-2 flex flex-col md:scroll-mt-24"
    aria-labelledby="profile-heading"
  >
    <Container
      title="About & Experience"
      tag="// 03. BACKGROUND"
      subtitle="Engineering trajectory, Unity certification, and systematic design skills."
      headingId="profile-heading"
    >
      <Profile />
    </Container>
  </section>

  <!-- 4. Creative Vault: 2D Illustrations & Artworks -->
  <section
    id="artworks"
    class="scroll-animate h-auto pb-16 md:pb-24 pt-2 flex flex-col md:scroll-mt-24"
    aria-labelledby="artworks-heading"
  >
    <Container
      title="Creative Vault"
      tag="// 04. 2D ART & VISUALS"
      subtitle="Character concept designs, pixel art landscapes, and creative illustrations."
      headingId="artworks-heading"
    >
      <Artworks artworks={artworks} client:visible />
    </Container>
  </section>

  <!-- 5. Devlog & Insights -->
  <section
    id="blogs"
    class="scroll-animate h-auto pb-16 md:pb-24 pt-2 flex flex-col md:scroll-mt-24"
    aria-labelledby="blogs-heading"
  >
    <Container
      title="Devlog & Insights"
      tag="// 05. WRITING"
      subtitle="Articles, post-mortems, and technical explorations."
      headingId="blogs-heading"
    >
      <Blogs blogs={blogs} />
    </Container>
  </section>
</Layout>

<script>
  import { initScrollAnimations } from '../scripts/scrollAnimations.ts';

  document.addEventListener('DOMContentLoaded', initScrollAnimations);
  document.addEventListener('astro:page-load', initScrollAnimations);
</script>

