---
import SiteHead from '@components/SiteHead.astro';
import '../styles/global.css';

const pageTitle = '404 - Page Not Found | Daffa Maulana Satria';
---

<html lang="en">
  <head>
    <SiteHead
      title={pageTitle}
      description="The requested page could not be found."
    />
  </head>

  <body class="crt-bg min-h-screen text-white flex flex-col items-center justify-center p-4 selection:bg-main selection:text-black">

      <h1 class="text-8xl sm:text-7xl font-black font-mono tracking-tighter text-white mb-2">
        404
      </h1>

      <p class="text-sm sm:text-sm font-mono text-gray-text leading-relaxed mb-8 max-w-sm mx-auto">
        The link is broken or not available.
      </p>

      <a
        href="/"
        class="btn-primary text-sm sm:text-sm font-mono uppercase tracking-wider inline-flex items-center gap-2 py-3 px-6 shadow-lg"
      >
        <span>Return to Home</span>
      </a>
  </body>
</html>
