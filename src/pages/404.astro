---
import SiteHead from '@components/SiteHead.astro';
import '../styles/global.css';

const pageTitle = '404 - Page Not Found | Daffa Maulana Satria';
---

<html lang="en">
  <head>
    <SiteHead
      title={pageTitle}
      description="The requested page could not be found."
    />
  </head>

  <body class="crt-bg min-h-screen text-white flex flex-col items-center justify-center p-4 selection:bg-main selection:text-black">
    <div class="glass-panel max-w-lg w-full p-8 sm:p-12 text-center border border-white/10 relative overflow-hidden">
      <!-- Glow Accent -->
      <div class="absolute -top-12 -left-12 w-40 h-40 bg-main/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-12 -right-12 w-40 h-40 bg-main/20 rounded-full blur-3xl pointer-events-none"></div>

      <!-- Error Tag -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-xl bg-main/15 border border-main/30 text-main text-xs font-mono font-bold uppercase tracking-widest mb-4">
        <span class="w-2 h-2 rounded-full bg-main animate-ping"></span>
        <span>ERROR 404</span>
      </div>

      <!-- 404 Headline -->
      <h1 class="text-6xl sm:text-7xl font-black font-mono tracking-tighter text-white mb-2" style="text-shadow: 0 0 20px var(--color-accent-glow);">
        404
      </h1>

      <h2 class="text-lg sm:text-xl font-bold text-white mb-3">
        SIGNAL LOST IN THE CYBERSPACE
      </h2>

      <p class="text-xs sm:text-sm font-mono text-gray-text leading-relaxed mb-8 max-w-sm mx-auto">
        The coordinates you entered do not exist or have been moved into another timeline.
      </p>

      <a
        href="/"
        class="btn-primary text-xs sm:text-sm font-mono uppercase tracking-wider inline-flex items-center gap-2 py-3 px-6 shadow-lg"
      >
        <span class="i-ri-home-4-line w-4 h-4"></span>
        <span>Return to Base</span>
      </a>
    </div>
  </body>
</html>
