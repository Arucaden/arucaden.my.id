---
interface Props {
  href?: string;
  text?: string;
}

const { href = '/#projects', text = 'Back to Projects' } = Astro.props as Props;
---

<a href={href} class="btn-back group mb-6">
  <span class="i-ri-arrow-left-line w-4 h-4 text-main transition-transform group-hover:-translate-x-1"></span>
  <span>{text}</span>
</a>
