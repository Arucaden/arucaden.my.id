---
import TechCard from '@/components/TechCard.svelte';
import { techItems } from '@data/techstack.ts';

interface Props {
  title: string;
  tech?: string[];
  url?: string;
  liveUrl?: string;
  sourceUrl?: string;
  repoUrl?: string;
  hasGallery?: boolean;
  headings?: Array<{ depth: number; slug: string; text: string }>;
}

const {
  tech = [],
  url,
  liveUrl,
  sourceUrl,
  repoUrl,
  hasGallery = false,
  headings = [],
} = Astro.props;

const finalLiveUrl = liveUrl || url;
const finalSourceUrl = sourceUrl || repoUrl;

const contentHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);

function findTechWithIcon(name: string) {
  const foundTech = techItems.find(
    (t) => t.name.toLowerCase() === name.toLowerCase()
  );

  return {
    name,
    type: 'tech' as const,
    icon: foundTech?.icon || undefined,
  };
}
---

<aside class="md:sticky md:top-6 self-start w-full space-y-6">
  <!-- Links -->
  {(finalLiveUrl || finalSourceUrl) && (
    <div class="rounded-2xl bg-white/[0.03] border border-white/50 p-4">
      <h2 id="links-heading" class="project-side-title">// LINKS</h2>
      <div class="flex gap-2 flex-wrap mt-2">
        {finalLiveUrl && (
          <a
            href={finalLiveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-white/[0.04] border border-white/10 hover:border-main hover:bg-main/10 text-gray-text hover:text-white text-xs font-mono transition-all duration-200 shadow-sm hover:shadow-[0_0_12px_rgba(255,59,105,0.25)] group"
          >
            <span class="i-ri-global-line w-4 h-4 text-main transition-transform group-hover:scale-110"></span>
            <span>Live Project</span>
          </a>
        )}
        {finalSourceUrl && (
          <a
            href={finalSourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-white/[0.04] border border-white/10 hover:border-main hover:bg-main/10 text-gray-text hover:text-white text-xs font-mono transition-all duration-200 shadow-sm hover:shadow-[0_0_12px_rgba(255,59,105,0.25)] group"
          >
            <span class="i-ri-github-fill w-4 h-4 text-main transition-transform group-hover:scale-110"></span>
            <span>Source Code</span>
          </a>
        )}
      </div>
    </div>
  )}

  <!-- Tech Stack -->
  {tech.length > 0 && (
    <div class="rounded-2xl bg-white/[0.03] border border-white/50 p-4">
      <h2 id="tech-heading" class="project-side-title">// TECH STACK</h2>
      <div class="flex gap-2 flex-wrap mt-2">
        {tech.map((t) => {
          const techWithIcon = findTechWithIcon(t);
          return (
            <TechCard
              name={techWithIcon.name}
              icon={techWithIcon.icon}
              type={techWithIcon.type}
              showName={true}
              customClass="px-2.5 py-1 text-xs"
              iconClass="w-3.5 h-3.5"
            />
          );
        })}
      </div>
    </div>
  )}

  <!-- Table of Contents -->
  {contentHeadings.length > 0 && (
    <div class="rounded-2xl bg-white/[0.03] border border-white/50 p-4">
      <h2 id="contents-heading" class="project-side-title">// CONTENTS</h2>
      <ul class="text-xs font-mono space-y-2 mt-2">
        {contentHeadings.map((heading) => (
          <li class={`${heading.depth === 3 ? 'ml-3' : ''}`}>
            <a
              href={`#${heading.slug}`}
              class="text-gray-text hover:text-main transition-colors flex items-center gap-1.5 py-0.5"
            >
              <span class="w-1 h-1 rounded-full bg-main/60"></span>
              <span>{heading.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}
</aside>
