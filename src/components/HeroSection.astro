---
import Hero3DScene from './3D/Hero3DScene.svelte';
import arrowDown from '../../public/icons/arrow-down.svg';
import { Image } from 'astro:assets';

const { name = 'DAFFA MAULANA SATRIA' } = Astro.props;
---

<section
  class="relative min-h-[90vh] md:min-h-screen w-full flex flex-col justify-center items-center text-center px-4 sm:px-6 py-16 md:py-24 overflow-hidden"
>
  <!-- Ambient background lighting -->
  <div class="absolute inset-0 cyber-grid pointer-events-none opacity-40"></div>
  <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[600px] h-[350px] bg-main/15 blur-[120px] rounded-full pointer-events-none"></div>

  <div class="relative z-10 max-w-5xl mx-auto flex flex-col items-center gap-6">
    <!-- Status Badge -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 backdrop-blur-md shadow-sm">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span class="text-xs font-mono text-gray-text tracking-wide">
        PORTFOLIO V2.6 // UI/UX & 3D CREATIVE TECH
      </span>
    </div>

    <!-- Main Editorial Headline -->
    <div class="space-y-3">
      <h1 class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-black tracking-tight text-white uppercase">
        {name}
      </h1>
      <p class="text-base sm:text-xl md:text-2xl font-mono text-main font-semibold tracking-wide">
        UI/UX Designer & Creative Technologist
      </p>
    </div>

    <!-- Subtitle statement -->
    <p class="max-w-2xl text-sm sm:text-base md:text-lg text-gray-text leading-relaxed">
      Designing tactile digital interfaces, procedural game architectures, and interactive WebGL experiences with systematic craftsmanship.
    </p>

    <!-- Interactive 3D WebGL Holographic Scene -->
    <div class="w-full max-w-2xl my-2">
      <Hero3DScene client:load />
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 mt-2">
      <a href="#projects" class="btn-primary">
        <span>Explore Case Studies</span>
        <span class="i-ri-arrow-down-line w-4 h-4"></span>
      </a>

      <a href="#lab" class="btn-secondary">
        <span class="i-ri-flask-line w-4 h-4 text-main"></span>
        <span>Launch UI/UX Lab</span>
      </a>

      <a
        href="https://drive.google.com/file/d/1hoDgLe8ihe8UtMwUHxrwFh3fDYPD43qw/view?usp=sharing"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-secondary"
      >
        <span class="i-ri-file-text-line w-4 h-4 text-gray-text"></span>
        <span>View Resume</span>
      </a>
    </div>
  </div>

  <!-- Scroll Down Indicator -->
  <div class="absolute bottom-6 md:bottom-8 z-10 flex flex-col items-center gap-1 opacity-70 hover:opacity-100 transition-opacity">
    <a href="#projects" class="flex flex-col items-center gap-1 text-gray-text hover:text-white" aria-label="Scroll to projects">
      <span class="text-[10px] font-mono tracking-widest uppercase">Scroll</span>
      <Image
        src={arrowDown}
        alt="Scroll down"
        width={18}
        height={18}
        class="w-4 h-4 animate-bounce"
      />
    </a>
  </div>
</section>

