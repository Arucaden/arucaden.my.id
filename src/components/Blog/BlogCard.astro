---
interface Props {
  title: string;
  excerpt: string;
  date: string;
  readTime?: string;
  tags?: string[];
  href?: string;
  pin?: boolean;
}

const { title, excerpt, date, readTime, tags = [], href = '#', pin = false } = Astro.props as Props;

const formattedDate = (() => {
  const d = new Date(date);
  return isNaN(d.getTime()) ? date : d.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: '2-digit' });
})();
---

<a
  href={href}
  class={`flex flex-col justify-between gap-4 rounded-2xl p-5 min-h-[190px] sm:min-h-[210px] transition-all duration-300 block group ${
    pin
      ? 'bg-main/10 border border-main/40 shadow-[0_0_20px_var(--color-accent-glow)] hover:border-main hover:bg-main/15'
      : 'bg-white/[0.03] border border-white/10 hover:border-main/50 hover:bg-white/[0.06] hover:shadow-[0_0_20px_var(--color-accent-glow)]'
  }`}
>
  <div>
    <!-- Top Row: Title + Date -->
    <div class="flex justify-between items-start gap-2 mb-1.5">
      <h3 class="font-bold text-base text-white group-hover:text-main transition-colors leading-snug">
        {title}
      </h3>
      <span class="text-[10px] font-mono whitespace-nowrap text-gray-text mt-0.5">
        {formattedDate}
      </span>
    </div>

    <!-- Read Time / Subtitle -->
    {readTime && (
      <span class="text-xs font-mono text-main font-medium block mb-2">
        {readTime}
      </span>
    )}

    <!-- Excerpt -->
    <p class="text-xs text-gray-text line-clamp-3 leading-relaxed">
      {excerpt}
    </p>
  </div>

  <!-- Bottom Badges / Tags -->
  {tags.length > 0 && (
    <div class="mt-auto flex flex-wrap gap-1.5 pt-3 border-t border-white/10">
      {tags.map((t) => (
        <span class="px-2.5 py-0.5 text-[10px] font-mono rounded-full border border-white/10 bg-white/5 text-gray-text group-hover:border-white/20">
          {t}
        </span>
      ))}
    </div>
  )}
</a>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
