---
import BlogCard from './BlogCard.astro';
import type { Blog } from '@/types/blog.ts';

interface Props {
  blogs: Blog[];
}

const { blogs } = Astro.props as Props;
---

<div class="flex flex-col">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    {blogs.map((b) => (
      <BlogCard 
        title={b.title}
        excerpt={b.excerpt}
        date={b.date}
        readTime={b.readTime}
        tags={b.tags}
        href={b.href}
        pin={b.pin}
      />
    ))}
    {blogs.length === 0 && (
      <div class="text-xs font-mono text-gray-text col-span-full py-8 text-center bg-white/[0.02] border border-white/5 rounded-2xl">
        No articles published yet. Coming soon.
      </div>
    )}
  </div>
</div>
