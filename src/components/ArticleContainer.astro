---
interface Props {
  title: string;
}

const { title } = Astro.props as Props;
---

<div class="article-container">
  <!-- Article Header with Dynamic Main Color Divider -->
  <div class="pb-4 mb-6 border-b border-main/30 flex items-center gap-3">
    <span class="w-2.5 h-2.5 rounded-full bg-main shadow-[0_0_10px_var(--color-accent-glow)]"></span>
    <h1 class="text-2xl sm:text-3xl md:text-4xl font-black tracking-tight text-white m-0">
      {title}
    </h1>
  </div>

  <!-- Content Slot -->
  <div>
    <slot />
  </div>
</div>
