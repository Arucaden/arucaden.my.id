---
interface Props {
  title: string;
}

const { title } = Astro.props as Props;
---

<div class="article-container">
  <!-- Article Header -->
  <div class="pb-4 mb-6 border-b border-white/50 flex items-center gap-3">
    <h1 class="text-2xl sm:text-3xl md:text-4xl font-black tracking-tight text-white m-0">
      {title}
    </h1>
  </div>

  <!-- Content Slot -->
  <div>
    <slot />
  </div>
</div>
