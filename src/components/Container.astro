---
interface Props {
  title: string;
  subtitle?: string;
  maxHeight?: boolean;
  headingId?: string;
}

const { title, subtitle, maxHeight = false, headingId } = Astro.props as Props;
const makeId = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const resolvedId = headingId || makeId(title);
---

<div class={`glass-panel p-4 sm:p-6 md:p-8 ${maxHeight ? 'md:max-h-xl md:overflow-auto' : ''}`}>
  <div class="flex items-center justify-between pb-3 mb-6 border-b border-white/40">
    <div class="flex items-center gap-2.5">
      <h2 id={resolvedId} class="text-xl sm:text-2xl md:text-3xl font-black tracking-tight text-white m-0">
        {title}
      </h2>
    </div>

    {subtitle && (
      <span class="text-xs sm:text-sm font-mono text-main font-semibold tracking-wide">
        {subtitle}
      </span>
    )}
  </div>

  <div>
    <slot />
  </div>
</div>
