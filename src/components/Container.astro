---
interface Props {
  title: string;
  subtitle?: string;
  tag?: string;
  maxHeight?: boolean;
  headingId?: string;
}

const { title, subtitle, tag, maxHeight = false, headingId } = Astro.props as Props;
const makeId = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const resolvedId = headingId || makeId(title);
---

<div class={`glass-panel p-4 sm:p-6 md:p-8 ${maxHeight ? 'md:max-h-xl md:overflow-auto' : ''}`}>
  <!-- Section Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-4 mb-6 border-b border-white/[0.08]">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="w-1.5 h-1.5 rounded-full bg-main"></span>
        <span class="text-xs font-mono text-gray-text tracking-widest uppercase">
          {tag || `// ${title.toUpperCase()}`}
        </span>
      </div>
      <h2 id={resolvedId} class="text-xl sm:text-2xl md:text-3xl font-black tracking-tight text-white m-0">
        {title}
      </h2>
    </div>

    {subtitle && (
      <p class="text-xs sm:text-sm font-mono text-gray-text max-w-md">
        {subtitle}
      </p>
    )}
  </div>

  <!-- Content Slot -->
  <div>
    <slot />
  </div>
</div>

