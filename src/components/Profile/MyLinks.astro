---
const links = [
  {
    name: 'Email',
    href: 'mailto:daffamaulanasatria@gmail.com',
    iconClass: 'i-ri-mail-fill',
    description: 'Contact me',
  },
  {
    name: 'LinkedIn',
    href: 'https://linkedin.com/in/daffa-ms',
    iconClass: 'i-ri-linkedin-fill',
    description: 'LinkedIn profile',
  },
  {
    name: 'GitHub',
    href: 'https://github.com/Arucaden',
    iconClass: 'i-ri-github-fill',
    description: 'Works and contributions',
  },
  {
    name: 'itch.io',
    href: 'https://itch.io/profile/arucaden',
    iconClass: 'i-ri-gamepad-fill',
    description: 'Check out my games',
  },
  {
    name: 'Resume',
    href: 'https://drive.google.com/file/d/1hoDgLe8ihe8UtMwUHxrwFh3fDYPD43qw/view?usp=sharing',
    iconClass: 'i-ri-file-text-fill',
    description: 'Read my resume here',
  },
];
---

<div class="flex flex-wrap gap-2.5">
  {links.map((link) => (
    <a
      href={link.href}
      class="inline-block transition-all relative group"
      target="_blank"
      aria-label={`${link.name}${link.description ? `: ${link.description}` : ''}`}
      title={link.description ? `${link.name} — ${link.description}` : link.name}
      rel="noopener noreferrer"
    >
      <div class="border-2 border-main bg-main/10 hover:bg-main/25 w-10 h-10 md:w-11 md:h-11 rounded-xl flex items-center justify-center transition-all duration-300 shadow-[0_0_12px_var(--color-accent-glow)] hover:scale-105 hover:shadow-[0_0_20px_var(--color-accent-glow)]">
        <span class={`${link.iconClass} w-5 h-5 text-main transition-transform duration-300 group-hover:scale-110`}></span>
      </div>

      <div
        role="tooltip"
        class="absolute top-10 left-0 mt-2 px-3 py-2 bg-black/95 border border-main text-white text-xs rounded-xl opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-all duration-300 pointer-events-none whitespace-nowrap z-20 shadow-[0_4px_20px_rgba(0,0,0,0.8)]"
      >
        <div class="font-bold text-main">{link.name}</div>
        {link.description && (
          <div class="text-[11px] text-gray-300 mt-0.5">{link.description}</div>
        )}
      </div>
    </a>
  ))}
</div>
