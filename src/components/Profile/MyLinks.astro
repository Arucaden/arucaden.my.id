---
import { links } from '@data/links.ts';

// Explicit literal icon references for UnoCSS static class extraction
const iconMap: Record<string, string> = {
  Email: 'i-ri-mail-fill',
  LinkedIn: 'i-ri-linkedin-fill',
  GitHub: 'i-ri-github-fill',
  'itch.io': 'i-ri-gamepad-fill',
  Resume: 'i-ri-file-text-fill',
};
---

<div class="flex flex-wrap gap-2.5">
  {links.map((link) => {
    const iconClass = link.iconClass || iconMap[link.name] || 'i-ri-link';
    return (
      <a
        href={link.href}
        class="inline-block transition-all relative group"
        target={link.isInternal ? undefined : '_blank'}
        aria-label={`${link.name}${link.description ? `: ${link.description}` : ''}`}
        title={link.description ? `${link.name} — ${link.description}` : link.name}
        rel={link.isInternal ? undefined : 'noopener noreferrer'}
      >
        <div class="border-2 border-white/20 hover:bg-main/25 hover:border-main w-12 h-12 md:w-14 md:h-11 rounded-xl flex items-center justify-center transition-all duration-300 hover:shadow-[0_0_20px_var(--color-accent-glow)]">
          <span class={`${iconClass} w-8 h-5 text-white/70 hover:text-main transition-transform duration-300`}></span>
        </div>

        <div
          role="tooltip"
          class="absolute top-10 left-0 mt-2 px-4 py-2 bg-black/95 border border-main text-white text-xs rounded-xl opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-all duration-300 pointer-events-none whitespace-nowrap z-20 shadow-[0_4px_12px_rgba(0,0,0,0.8)]"
        >
          <div class="font-bold text-main">{link.name}</div>
          {link.description && (
            <div class="text-[11px] text-gray-300 mt-0.5">{link.description}</div>
          )}
        </div>
      </a>
    );
  })}
</div>
