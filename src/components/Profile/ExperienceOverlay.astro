---
import { experiences } from "@data/experiences.ts";
import Overlay from "@components/Overlay.astro";
import ExperienceBadge from "./ExperienceBadge.svelte";
---

<Overlay
  id="experiences-overlay"
  title="Experiences"
  closeButtonId="hide-all-experiences"
  closeLabel="Close"
>
  <div class="space-y-3 p-1">
    {
      experiences.map((exp) => (
        <article class="flex flex-col justify-between gap-3 rounded-2xl p-4 bg-white/[0.03] border border-white/10 hover:border-main/50 hover:bg-white/[0.06] hover:shadow-[0_0_20px_var(--color-accent-glow)] transition-all duration-300">
          <div>
            <div class="flex justify-between items-start gap-2 mb-1">
              <span class="font-bold text-sm text-white">{exp.company}</span>
              <span class="text-[10px] font-mono whitespace-nowrap text-gray-text">{exp.period}</span>
            </div>

            {exp.role && (
              <span class="text-xs font-mono text-main font-medium block">{exp.role}</span>
            )}

            {exp.points?.length > 0 && (
              <ul class="mt-2.5 list-disc list-inside space-y-1 text-xs text-gray-text leading-relaxed">
                {exp.points.map((pt) => (
                  <li class="leading-relaxed">{pt}</li>
                ))}
              </ul>
            )}
          </div>

          <div class="mt-2 flex flex-wrap gap-1.5 pt-2 border-t border-white/10">
            <ExperienceBadge text={exp.type} />
            <ExperienceBadge text={exp.location} />
          </div>
        </article>
      ))
    }
  </div>
</Overlay>
