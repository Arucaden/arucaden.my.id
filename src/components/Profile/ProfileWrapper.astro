---
import '@/styles/profile.css';
import TechCard from '../TechCard.svelte';
import Experiences from './Experiences.svelte';
import ExperienceOverlay from './ExperienceOverlay.astro';
import { techItems } from '@data/techstack.ts';
import { certificates } from '@data/certificates.ts';
import { Image } from 'astro:assets';
import me from '@/public/Me.jpeg';
import MyLinks from './MyLinks.astro';

const techToShow = [
  'Unity', 'Figma', 'TypeScript', 'Clip Studio', 'Laravel', 'Flutter', 'Spline', 'MySQL', 'three.js', 'Svelte'
];

const tech = techItems
  .filter(item => item.type === 'tech' && techToShow.includes(item.name));

const highlightedTechSet = new Set(["Unity", "Clip Studio", "Figma", "TypeScript"]);
---

<div id="profile-shell" class="relative">
  <div id="profile-content" class="flex flex-col gap-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-x-12 items-start">
      <!-- Description + Links + Tech + Certificates -->
      <div id="profile-left" class="flex flex-col gap-6 md:col-span-2">
        <section aria-labelledby="desc-heading" class="flex flex-col">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-mono text-main uppercase tracking-widest">// ABOUT</span>
            <button id="show-portrait" class="md:hidden text-xs font-mono text-main hover:text-white transition-colors">
              [View Portrait]
            </button>
          </div>

          <p id="desc-paragraph" class="text-sm sm:text-base text-gray-text leading-relaxed">
            Computer Science student graduate. I like to explore new technologies and create innovative solutions.
On my free time, I like to watch anime or play games, drawing included.
          </p>
        </section>

        <!-- Certificates -->
        {certificates.length > 0 && (
          <section aria-labelledby="cert-heading">
            <span id="cert-heading" class="text-xs font-mono text-main uppercase tracking-widest block mb-2">// CERTIFICATE</span>
            <div class="flex flex-row flex-wrap gap-2 py-1">
              {certificates.map((cert) => (
                <a
                  href={cert.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`inline-flex items-center gap-2 rounded-xl bg-white/[0.04] border px-4 py-2.5 text-xs font-mono transition-all duration-200 hover:border-main hover:bg-main/15 hover:text-main hover:shadow-[0_0_12px_var(--color-accent-glow)] group cursor-pointer ${
                    cert.highlight
                      ? 'text-white border-main bg-main/10 shadow-[0_0_12px_var(--color-accent-glow)]'
                      : 'text-gray-text border-white/10'
                  }`}
                  title={`View Certificate: ${cert.name}`}
                >
                  {cert.icon ? (
                    <img
                      src={cert.icon}
                      alt={cert.name}
                      width="18"
                      height="18"
                      class="w-4.5 h-4.5 object-contain transition-transform duration-200"
                    />
                  ) : (
                    <div class="i-ri-shield-check-fill w-4.5 h-4.5 text-main shrink-0"></div>
                  )}
                  <span class="font-medium text-white group-hover:text-main transition-colors">{cert.name}</span>
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- Links -->
        <section aria-labelledby="links-heading">
          <span id="links-heading" class="text-xs font-mono text-main uppercase tracking-widest block mb-2">// Contacts</span>
          <MyLinks />
        </section>

        <!-- Tech Stack -->
        <section aria-labelledby="tech-heading">
          <div class="flex justify-between items-center mb-2">
            <span id="tech-heading" class="text-xs font-mono text-main uppercase tracking-widest">// TECH STACK</span>
            <button id="tech-toggle" class="md:hidden text-xs font-mono text-main hover:text-white">Show All</button>
          </div>

          <div id="tech-container" class="flex flex-row flex-wrap gap-2 md:max-h-full max-h-[120px] overflow-y-hidden transition-all duration-300 py-1 px-1">
            {tech.map((t, index) => (
              <div class={`tech-card-wrapper ${index > 6 ? 'md:opacity-100 md:translate-y-0 hidden-card opacity-0 translate-y-0' : ''}`}>
                <TechCard
                  name={t.name}
                  type={t.type}
                  icon={t.icon}
                  highlight={highlightedTechSet.has(t.name)}
                  showName={true}
                  client:visible
                />
              </div>
            ))}
          </div>
        </section>
      </div>

      <!-- Right Column: Portrait -->
      <aside class="hidden md:flex flex-col gap-4 md:col-span-1">
        <div>
          <span class="text-xs font-mono text-main uppercase tracking-widest block mb-2">// PROFILE</span>
          <div
            id="portrait-wrapper"
            class="relative w-full overflow-hidden rounded-2xl border-2 border-white/20 hover:border-main shadow-[0_8px_30px_rgba(0,0,0,0.6)] hover:shadow-[0_0_24px_var(--color-accent-glow)] transition-all duration-300 group"
          >
            <Image
              src={me}
              alt="Portrait of Daffa Maulana Satria"
              widths={[200, 400]}
              sizes="(max-width: 768px) 100vw, 50vw"
              class="w-full h-full object-cover object-top filter grayscale contrast-105 group-hover:grayscale-0 group-hover:contrast-100 transition-all duration-500 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-3">
              <span class="text-sm font-mono text-white">Daffa Maulana Satria</span>
            </div>
          </div>
        </div>
      </aside>
    </div>

    <!-- Experiences -->
    <div class="pt-4 border-t border-white/10">
      <Experiences client:visible />
    </div>
  </div>

  <!-- Experiences Overlay -->
  <ExperienceOverlay />
</div>

<!-- Mobile Portrait -->
<div id="portrait-overlay" class="fixed inset-0 bg-black/90 z-50 hidden flex-col items-center justify-center p-4">
  <div class="relative w-3/4 max-w-md max-h-[80vh] overflow-hidden rounded-2xl border-2 border-white/20">
    <Image 
      src={me}
      alt="Portrait of Daffa Maulana Satria"
      widths={[400, 800]}
      sizes="100vw"
      class="w-full h-auto rounded-2xl filter grayscale hover:grayscale-0 transition-all duration-500"
    />
    <button 
      id="close-portrait" 
      class="absolute top-3 right-3 p-1.5 rounded-full bg-black/70 border border-white/20"
      aria-label="Close portrait"
    >
      <img 
        src="/icons/close-button.svg" 
        alt="Close" 
        width="20" 
        height="20"
      />
    </button>
  </div>
</div>

<script>
  import { initProfileEffects } from '../../scripts/profileEffects.js';
  
  document.addEventListener('DOMContentLoaded', () => {
    const cleanup = initProfileEffects();
    
    document.addEventListener('astro:before-swap', cleanup);
  });
</script>
